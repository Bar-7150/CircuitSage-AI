# ========================================================
# CircuitSage AI — Root Environment Variables Example
# ========================================================
# Copy this file to .env in respective app directories:
#   apps/api/.env
#   apps/web/.env.local
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL!
# ========================================================

# --------------------------------------------------------
# Backend API Configuration (apps/api/.env)
# --------------------------------------------------------
PORT=8000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Supabase Postgres & Auth (Online Mode)
# Replace with your development Supabase project values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Local Gemma 4 AI Runtime
GEMMA_RUNTIME_URL=http://127.0.0.1:11434
GEMMA_MODEL_NAME=gemma4:latest
INFERENCE_TIMEOUT_MS=30000

# Local Storage (Offline Fallback & Uploads)
LOCAL_DATA_DIR=./data

# --------------------------------------------------------
# Frontend Configuration (apps/web/.env.local)
# --------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
