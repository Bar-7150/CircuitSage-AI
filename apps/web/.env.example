# ========================================================
# CircuitSage AI — Next.js Frontend Configuration
# ========================================================

# Base URL pointing to the Express.js Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Client Configuration (Public anon keys only)
# NEVER put service-role keys in this file!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
